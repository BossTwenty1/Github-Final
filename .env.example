# Copy this file to .env.local for the local Docker fallback, then fill the
# publishable/anonymous key from `npx supabase status`. Never put a service-role
# key in this file or client code. The app shows LOCAL or HOSTED DEVELOPMENT.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Optional private Storage bucket name for administrator photo uploads.
NEXT_PUBLIC_SUPABASE_PHOTOS_BUCKET=

# Server-only Auth Admin key for protected account provisioning. Keep this in
# your uncommitted .env.local only; never use a NEXT_PUBLIC_ name for it.
SUPABASE_SECRET_KEY=
# Legacy Supabase service-role name is also accepted when Secret keys are not
# available in the active development project.
# SUPABASE_SERVICE_ROLE_KEY=
