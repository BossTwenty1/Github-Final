# Hosted Supabase development target. Copy to .env.local and replace both
# placeholders using values supplied privately by the authorized project owner.
# Never add a service-role/secret key here, and never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_HOSTED_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional server-only key required only for protected ADMIN account
# provisioning. Put it in your uncommitted .env.local; never expose it as a
# NEXT_PUBLIC_ variable or commit it.
SUPABASE_SECRET_KEY=
# Legacy fallback accepted by the server:
# SUPABASE_SERVICE_ROLE_KEY=
